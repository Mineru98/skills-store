{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mineru98/skills-store/schemas/issue-phase/phase-envelope-v1.schema.json",
  "title": "Issue lifecycle machine phase envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "contractId",
    "phaseId",
    "checkpoint",
    "ok",
    "data",
    "observedFacts",
    "proposedEffect",
    "handback",
    "error"
  ],
  "properties": {
    "apiVersion": {
      "const": "issue-phase/v1"
    },
    "contractId": {
      "const": "issue-phase-api-v1"
    },
    "phaseId": {
      "type": "string",
      "enum": [
        "issue-start.intake",
        "issue-start.fetch",
        "issue-start.classify",
        "issue-start.plan",
        "issue-start.worktree",
        "issue-start.before",
        "issue-start.implement",
        "issue-start.commit",
        "issue-start.after",
        "issue-start.publish-evidence",
        "issue-start.comment",
        "issue-start.sync-base",
        "issue-start.handback",
        "issue-end.context",
        "issue-end.approval-evidence",
        "issue-end.before-recapture",
        "issue-end.after-recapture",
        "issue-end.report",
        "issue-end.publish-evidence",
        "issue-end.sync-base",
        "issue-end.comment",
        "issue-end.review-approval",
        "issue-end.pr",
        "issue-end.handback",
        "issue-merge.base-tree",
        "issue-merge.inventory",
        "issue-merge.map",
        "issue-merge.candidate",
        "issue-merge.preflight-plan",
        "issue-merge.resolve-review",
        "issue-merge.merge-verify",
        "issue-merge.close-cleanup",
        "issue-merge.handback"
      ]
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": "object"
    },
    "observedFacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observedFact"
      }
    },
    "proposedEffect": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/proposedEffect"
        }
      ]
    },
    "handback": {
      "$ref": "#/$defs/handback"
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "handback": {
            "properties": {
              "disposition": {
                "enum": [
                  "complete",
                  "held"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "proposedEffect": {
            "type": "null"
          },
          "handback": {
            "properties": {
              "disposition": {
                "const": "failed"
              }
            }
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposedEffect": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "handback": {
            "properties": {
              "disposition": {
                "const": "held"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phaseId": {
            "pattern": "^issue-start\\."
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint": {
            "properties": {
              "owner": {
                "const": "issue-start"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phaseId": {
            "pattern": "^issue-end\\."
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint": {
            "properties": {
              "owner": {
                "const": "issue-end"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phaseId": {
            "pattern": "^issue-merge\\."
          }
        }
      },
      "then": {
        "properties": {
          "checkpoint": {
            "properties": {
              "owner": {
                "const": "issue-merge"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "attempt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "enum": [
            "issue-start",
            "issue-end",
            "issue-merge"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "observedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    },
    "proposedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "classification",
        "request",
        "type"
      ],
      "properties": {
        "approvalId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "classification": {
          "enum": [
            "local-idempotent",
            "approval-required",
            "uncertain-non-idempotent"
          ]
        },
        "request": {
          "type": "object"
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "approval-required"
              }
            }
          },
          "then": {
            "properties": {
              "approvalId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "handback": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "resume",
            "retry"
          ],
          "properties": {
            "disposition": {
              "const": "complete"
            },
            "resume": {
              "const": "next"
            },
            "retry": {
              "const": "never"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "resume",
            "retry"
          ],
          "properties": {
            "disposition": {
              "const": "held"
            },
            "resume": {
              "const": "same"
            },
            "retry": {
              "const": "reconcile"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "resume",
            "retry"
          ],
          "properties": {
            "disposition": {
              "const": "failed"
            },
            "resume": {
              "const": "none"
            },
            "retry": {
              "const": "never"
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
