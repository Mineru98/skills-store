{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mineru98/skills-store/contracts/issue-start-phase-api-v1.json",
  "title": "Reviewed issue-start phase request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "contractId",
    "phaseId",
    "checkpoint",
    "state",
    "input",
    "effectResult"
  ],
  "properties": {
    "apiVersion": {
      "const": "issue-phase/v1"
    },
    "contractId": {
      "const": "issue-start-phase-api-v1"
    },
    "phaseId": {
      "enum": [
        "issue-start.intake",
        "issue-start.fetch",
        "issue-start.classify",
        "issue-start.plan",
        "issue-start.worktree",
        "issue-start.before",
        "issue-start.implement",
        "issue-start.commit",
        "issue-start.after",
        "issue-start.publish-evidence",
        "issue-start.comment",
        "issue-start.sync-base",
        "issue-start.handback"
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "attempt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "const": "issue-start"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "baseCheckout",
        "issueWorktree",
        "branch",
        "completedPhases",
        "beforeCaptured",
        "implementationCommitted",
        "evidenceCommitted",
        "evidencePushed",
        "commentPublished",
        "baseSynced"
      ],
      "properties": {
        "issue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "baseCheckout": {
          "$ref": "#/$defs/absolutePath"
        },
        "issueWorktree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/absolutePath"
            }
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "completedPhases": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "$ref": "#/properties/phaseId"
          }
        },
        "beforeCaptured": {
          "type": "boolean"
        },
        "implementationCommitted": {
          "type": "boolean"
        },
        "evidenceCommitted": {
          "type": "boolean"
        },
        "evidencePushed": {
          "type": "boolean"
        },
        "commentPublished": {
          "type": "boolean"
        },
        "baseSynced": {
          "type": "boolean"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseDirty",
        "issueBody",
        "classification",
        "planPath",
        "intendedWorktree",
        "intendedBranch",
        "commitMessage",
        "beforeArtifact",
        "afterArtifact",
        "commentFile",
        "baseBranch"
      ],
      "properties": {
        "baseDirty": {
          "type": "boolean"
        },
        "issueBody": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "frontend",
            "backend",
            "both",
            "neither",
            null
          ]
        },
        "planPath": {
          "$ref": "#/$defs/absolutePath"
        },
        "intendedWorktree": {
          "$ref": "#/$defs/absolutePath"
        },
        "intendedBranch": {
          "type": "string",
          "minLength": 1
        },
        "commitMessage": {
          "type": "string",
          "minLength": 1
        },
        "beforeArtifact": {
          "$ref": "#/$defs/absolutePath"
        },
        "afterArtifact": {
          "$ref": "#/$defs/absolutePath"
        },
        "commentFile": {
          "$ref": "#/$defs/absolutePath"
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effectResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvalId",
            "status",
            "receipt"
          ],
          "properties": {
            "approvalId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "status": {
              "enum": [
                "succeeded",
                "failed",
                "unknown"
              ]
            },
            "receipt": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    }
  },
  "x-phaseOrder": [
    "issue-start.intake",
    "issue-start.fetch",
    "issue-start.classify",
    "issue-start.plan",
    "issue-start.worktree",
    "issue-start.before",
    "issue-start.implement",
    "issue-start.commit",
    "issue-start.after",
    "issue-start.publish-evidence",
    "issue-start.comment",
    "issue-start.sync-base",
    "issue-start.handback"
  ],
  "x-invariants": {
    "implementationTarget": "issueWorktree-only",
    "before": "before-capture-before-implementation",
    "commits": "implementation-and-evidence-separate",
    "publication": "evidence-push-before-comment",
    "forbidden": [
      "pr-create",
      "merge",
      "base-checkout-implementation",
      "unapproved-push",
      "unapproved-comment"
    ]
  }
}
