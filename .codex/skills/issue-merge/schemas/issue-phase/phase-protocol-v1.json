{
  "apiVersion": "issue-phase/v1",
  "contractId": "issue-phase-api-v1",
  "canonicalization": "RFC8785",
  "legalExitCodes": {
    "completed": 0,
    "internalError": 1,
    "invalidRequest": 2,
    "held": 3
  },
  "effectClassifications": [
    "local-idempotent",
    "approval-required",
    "uncertain-non-idempotent"
  ],
  "checkpointOwnership": {
    "issue-start.*": "issue-start",
    "issue-end.*": "issue-end",
    "issue-merge.*": "issue-merge"
  },
  "handbackRules": {
    "complete": {
      "resume": "next",
      "retry": "never"
    },
    "held": {
      "resume": "same",
      "retry": "reconcile"
    },
    "failed": {
      "resume": "none",
      "retry": "never"
    }
  }
}
