{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-phase-capability-bundle-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "bundleId",
    "capabilitySetSha256",
    "closure",
    "mirrors",
    "phases",
    "repositoryOrigin",
    "schemaVersion"
  ],
  "properties": {
    "apiVersion": { "const": "issue-phase/v1" },
    "bundleId": { "const": "issue-phase-capability-bundle-v1" },
    "capabilitySetSha256": { "$ref": "#/$defs/sha256" },
    "repositoryOrigin": { "const": "https://github.com/Mineru98/skills-store" },
    "schemaVersion": { "const": 1 },
    "mirrors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root"],
        "properties": {
          "id": { "enum": ["claude", "codex"] },
          "root": { "enum": [".claude", ".codex"] }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": { "$ref": "#/$defs/phase" }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "entries", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-raw-bytes" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalClass", "type"],
      "properties": {
        "approvalClass": {
          "enum": ["local-idempotent", "approval-required", "uncertain-non-idempotent"]
        },
        "type": { "type": "string", "minLength": 1 }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalClasses",
        "checkpoint",
        "effects",
        "invocation",
        "phaseId",
        "reconciliationQueries",
        "requestSchemaPath",
        "skill"
      ],
      "properties": {
        "phaseId": { "type": "string", "minLength": 1 },
        "skill": { "enum": ["issue-start", "issue-end", "issue-merge"] },
        "requestSchemaPath": { "$ref": "#/$defs/relativePath" },
        "invocation": {
          "type": "array",
          "minItems": 5,
          "items": { "type": "string", "minLength": 1 }
        },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "approvalClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["local-idempotent", "approval-required", "uncertain-non-idempotent"]
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "requestFields", "responseOwner"],
          "properties": {
            "owner": { "enum": ["issue-start", "issue-end", "issue-merge"] },
            "requestFields": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            },
            "responseOwner": { "enum": ["issue-start", "issue-end", "issue-merge"] }
          }
        },
        "reconciliationQueries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fields", "kind"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
